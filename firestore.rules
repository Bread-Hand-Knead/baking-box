rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "linda6623@gmail.com" || 
        request.auth.token.email == "linda6623@gamil.com"
      );
    }

    // 檢查資料庫寫入動作是否嘗試修改任何 VIP / 權限 / 方案敏感欄位
    function touchesSensitiveFields(data) {
      return data.keys().hasAny([
        'plan', 'vipExpiresAt', 'trial_until', 'is_permanent_vip',
        'subscriptionStatus', 'subscriptionType', 'role', 'is_vip',
        'ai_parse_count', 'aiUsage'
      ]);
    }

    // Helper: Validate Identity in data
    function isInputOwner(data) {
      return (data.get('uid', '') == request.auth.uid) || 
             (data.get('author_id', '') == request.auth.uid);
    }

    // Helper: check if existing doc is owned
    function isDocOwner() {
      return (existing().get('uid', '') == request.auth.uid) || 
             (existing().get('author_id', '') == request.auth.uid);
    }

    // Helper: Validate Recipe data shape
    function isValidRecipe(data) {
      return data.keys().hasAll(['title', 'category'])
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 100
        && (!('uid' in data) || (data.uid is string || data.uid == null))
        && (!('author_id' in data) || (data.author_id is string || data.author_id == null));
    }

    // Match Blocks
    
    // 1) userSettings: 使用者可讀取自己的設定。寫入時，一般使用者絕對禁止修改敏感欄位；僅管理員或 Cloud Functions (Admin SDK) 可更動。
    match /userSettings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin() || (isOwner(userId) && !touchesSensitiveFields(incoming()));
      allow delete: if isAdmin();
    }

    // 2) user_usage: 使用者只能讀取自己的用量紀錄。寫入一律鎖死，僅由 Cloud Functions Admin SDK 寫入
    match /user_usage/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /user_categories/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (resource == null) || 
        isDocOwner()
      );

      allow create: if isVerified() && isValidId(recipeId) && isValidRecipe(incoming()) && (
        isAdmin() || isInputOwner(incoming())
      );

      allow update: if isVerified() && isValidRecipe(incoming()) && (
        isAdmin() || (
          isDocOwner() && 
          (existing().get('uid', '') == '' || incoming().get('uid', '') == existing().get('uid', '')) &&
          (existing().get('author_id', '') == '' || incoming().get('author_id', '') == existing().get('author_id', ''))
        )
      );

      allow delete: if isSignedIn() && (
        isAdmin() || isDocOwner()
      );
    }
    
    match /drafts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /user_knowledge/{knowledgeId} {
      allow read, write: if isSignedIn() && (isAdmin() || resource.data.uid == request.auth.uid || incoming().uid == request.auth.uid);
    }
  }
}
